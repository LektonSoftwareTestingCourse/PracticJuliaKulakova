{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthorizationResponse",
  "description": "Контракт ответа авторизации: docs/api-spec.md, модель AuthorizationResponse",
  "type": "object",
  "required": ["mti", "stan", "rrn", "authCode", "responseCode", "status", "declineReason", "processingTimeMs"],
  "additionalProperties": false,
  "properties": {
    "mti": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "stan": {
      "type": "string",
      "pattern": "^\\d{6}$"
    },
    "rrn": {
      "type": ["string", "null"],
      "pattern": "^\\d{12}$"
    },
    "authCode": {
      "type": ["string", "null"],
      "pattern": "^[A-Z0-9]{6}$"
    },
    "responseCode": {
      "type": "string",
      "pattern": "^\\d{2}$"
    },
    "status": {
      "enum": ["APPROVED", "DECLINED"]
    },
    "declineReason": {
      "type": ["string", "null"]
    },
    "processingTimeMs": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  }
}
